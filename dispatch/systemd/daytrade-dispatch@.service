# Backup trigger for the Cloudflare dispatcher. See dispatch/README.md.
[Unit]
Description=Dispatch %i.yml (backup trigger)
StartLimitIntervalSec=20min
StartLimitBurst=10

[Service]
Type=oneshot
# GH_TOKEN=<fine-grained PAT, Actions: read/write on this repo only>
EnvironmentFile=%h/.config/daytrade/dispatch.env
ExecStart=%h/.local/bin/gh workflow run %i.yml --repo ConnorHampstead/claude-portfolio --ref main -f dry_run=false
# Covers waking from sleep before the network is back.
Restart=on-failure
RestartSec=60
