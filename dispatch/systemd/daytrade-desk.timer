[Unit]
Description=Backup trigger: trading desk

[Timer]
# 5 min ahead of the 09:05 ET target, 5 min after the Cloudflare dispatch. A
# short hold, so the ~20 min session still finishes a few minutes before the
# bell. If the Cloudflare dispatch already ran, this waits in the queue (no
# runner held) and exits on the already-ran marker.
OnCalendar=Mon..Fri 09:00 America/New_York
Persistent=true
Unit=daytrade-dispatch@desk.service

[Install]
WantedBy=timers.target
