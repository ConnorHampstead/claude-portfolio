[Unit]
Description=Backup trigger: trading desk

[Timer]
# 1h ahead of the 09:05 ET target, 1h after the Cloudflare dispatch. If that
# one ran, this waits in the queue (no runner held) and exits on the
# already-ran marker; if not, it does the session with an hour to spare.
OnCalendar=Mon..Fri 08:05 America/New_York
Persistent=true
Unit=daytrade-dispatch@desk.service

[Install]
WantedBy=timers.target
